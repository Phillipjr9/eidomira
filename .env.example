# Eidomira configuration. Copy to `.env` and edit.
#
# Everything here is optional: the defaults run a diagnostic backend with no model files,
# which is deliberate. See README.md for what each one changes, and
# docs/quality-and-licensing.md before pointing the restoration path at a model.

# ── Public URL ────────────────────────────────────────────────────────────────
# Used in verification links. Without SMTP those links print to the server log.
STUDIO_PUBLIC_URL=http://127.0.0.1:8000

# ── Swap engine ───────────────────────────────────────────────────────────────
# No swap weights ship with this repository. Until model_path exists, the engine stays
# on the diagnostic backend and says so in GET /api/health.
STUDIO_BACKEND=diagnostic
STUDIO_MODEL_PATH=models/inswapper_128.onnx

# ── Execution providers (read from the environment, no STUDIO_ prefix) ─────────
# Leave unset for automatic ordering, which ends in CPU. Set EIDOMIRA_TENSORRT=1 only if
# you accept a one-off engine build on first use.
# EIDOMIRA_PROVIDERS=cuda,cpu
# EIDOMIRA_TENSORRT=0

# ── Post-swap refinement ──────────────────────────────────────────────────────
# Tone transfer needs no model and is safe to leave on. Restoration is skipped entirely
# when the file is absent, so a missing model degrades to a softer swap, not an error.
STUDIO_TONE_TRANSFER_STRENGTH=1.0
STUDIO_RESTORATION_MODEL_PATH=models/gfpgan_1.4.onnx
STUDIO_RESTORATION_VISIBILITY=0.75

# ── Semantic compositing (optional) ───────────────────────────────────────────
STUDIO_PARSER_MODEL_PATH=models/face_parser.onnx
STUDIO_PARSER_FEATHER=0.035
STUDIO_PARSER_INCLUDE_EARS=true

# ── Temporal stabilisation ────────────────────────────────────────────────────
STUDIO_TEMPORAL_STRENGTH=0.22
STUDIO_TEMPORAL_MOTION_THRESHOLD=24.0

# ── Frame pipeline ────────────────────────────────────────────────────────────
STUDIO_MAX_FRAME_WIDTH=960
STUDIO_JPEG_QUALITY=82

# ── Auth, sessions, limits ────────────────────────────────────────────────────
# Signs every session and verification token. Anyone who knows it can mint a token for
# any account, and the app behaves normally while it is wrong — so app.main warns at boot
# if this is still the shipped default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STUDIO_AUTH_SECRET=development-only-change-me
STUDIO_MAX_SESSIONS=25
STUDIO_SESSION_TTL_SECONDS=1800
STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Email verification ────────────────────────────────────────────────────────
# Without SMTP, development verification URLs are printed to the server log. That is not
# acceptable in production.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ── TURN (needed when peers cannot reach each other directly) ─────────────────
STUDIO_TURN_URLS=
STUDIO_TURN_SECRET=
STUDIO_TURN_REALM=eidomira.local
