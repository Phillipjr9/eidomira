{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eidomira authorized training subject",
  "type": "object",
  "required": ["subject_id", "consent_id", "adult_confirmed", "license", "assets", "split"],
  "properties": {
    "subject_id": {"type": "string", "minLength": 8},
    "consent_id": {"type": "string", "minLength": 8},
    "adult_confirmed": {"const": true},
    "license": {"enum": ["performer-release", "commercial-dataset", "synthetic"]},
    "jurisdictions": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "revoked": {"type": "boolean", "default": false},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"enum": ["image", "video"]}
        },
        "additionalProperties": false
      }
    },
    "split": {"enum": ["train", "validation", "test"]}
  },
  "additionalProperties": false
}
