.venv/
__pycache__/
.pytest_cache/
.env
.env.*
# ...but the template is meant to be committed: the README tells operators to copy it.
!.env.example
license*/
licensed-models/
# Generated by `python -m tools.deploy_vm` for the host that runs it, not for the repo.
Caddyfile
*.onnx
# ...except the lab's stand-in: 277 bytes, no license to respect, and the page 404s without it.
!static/lab/swapper-standin.onnx
*.db
*.pem
# Written at runtime: the trainer's per-session reports, and the settings the offline
# trainer measured. Both are regenerated, and neither should be committed by accident.
reports/*
# ...except the sample in the README, so the format is documented rather than described.
!reports/example-session-report.md
data/tuned_defaults.json
captures/
*.log
.DS_Store
